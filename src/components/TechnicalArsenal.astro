---
---

<section id="arsenal" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
      — Technical Arsenal
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal reveal-d1">
    
    <!-- Column 1: SECURITY OPERATIONS -->
    <div class="cyber-frame p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-[2px] mb-6 pb-2 border-b border-[var(--border-frame)]">
          SECURITY OPERATIONS
        </div>

        <div class="space-y-6">
          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Threat Detection</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[85%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Incident Response</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[80%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Log Analysis & Triaging</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[88%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Vulnerability Assessment</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[75%]"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 mt-6 border-t border-[var(--border-subtle)] flex items-center justify-between text-mono text-[0.65rem] text-[var(--text-muted)]">
        <span>SEC-OPS</span>
        <span>· · ·</span>
      </div>
    </div>

    <!-- Column 2: TOOLS & PLATFORMS -->
    <div class="cyber-frame p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-[2px] mb-6 pb-2 border-b border-[var(--border-frame)]">
          TOOLS & PLATFORMS
        </div>

        <div class="space-y-6">
          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Wazuh / Elastic SIEM</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[85%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Wireshark</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[90%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Nmap / Nessus</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[82%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">pfSense / Suricata</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[78%]"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 mt-6 border-t border-[var(--border-subtle)] flex items-center justify-between text-mono text-[0.65rem] text-[var(--text-muted)]">
        <span>TOOLING</span>
        <span>· · ·</span>
      </div>
    </div>

    <!-- Column 3: NETWORK & INFRASTRUCTURE -->
    <div class="cyber-frame p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-[2px] mb-6 pb-2 border-b border-[var(--border-frame)]">
          NETWORK & INFRA
        </div>

        <div class="space-y-6">
          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Infrastructure Hardening</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[90%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">TCP/IP & Routing</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[85%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Firewall Policy Design</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[82%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Network Segmentation</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[88%]"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 mt-6 border-t border-[var(--border-subtle)] flex items-center justify-between text-mono text-[0.65rem] text-[var(--text-muted)]">
        <span>NET-ENG</span>
        <span>· · ·</span>
      </div>
    </div>

    <!-- Column 4: DEVELOPMENT -->
    <div class="cyber-frame p-6 sm:p-8 flex flex-col justify-between">
      <div>
        <div class="font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-[2px] mb-6 pb-2 border-b border-[var(--border-frame)]">
          DEVELOPMENT
        </div>

        <div class="space-y-6">
          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Python</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[85%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Flask / REST APIs</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[78%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">JavaScript</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[75%]"></div>
            </div>
          </div>

          <div>
            <span class="text-xs font-bold text-[var(--text-primary)] block mb-1.5">Linux / Kali</span>
            <div class="w-full h-1 bg-[var(--border-frame)] rounded-none overflow-hidden">
              <div class="h-full bg-[var(--text-primary)] w-[90%]"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-6 mt-6 border-t border-[var(--border-subtle)] flex items-center justify-between text-mono text-[0.65rem] text-[var(--text-muted)]">
        <span>DEV-SEC</span>
        <span>· · ·</span>
      </div>
    </div>

  </div>
</section>
