---
import { getCollection, render } from 'astro:content';

let entries = [];
try {
  entries = await getCollection('journal');
  entries.sort((a, b) => {
    const weekA = a.data.week ?? 0;
    const weekB = b.data.week ?? 0;
    return weekB - weekA;
  });
} catch (e) {
  console.warn('Could not load journal entries:', e);
}

// Render each entry's content
const renderedEntries = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await render(entry);
    return {
      entry,
      Content,
    };
  })
);
---

<section id="journal" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
        Weekly Progress Logs
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[var(--text-primary)] cyber-glow-text cyber-glitch" data-text="WEEKLY LOG.">
      Weekly Log.
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-body)] mt-2 max-w-2xl">
      Weekly logs keeping track of what i did on a weekly basis.
    </p>
  </div>

  <div class="space-y-6">
    {renderedEntries.length > 0 ? (
      renderedEntries.map(({ entry, Content }, index) => {
        const weekNum = entry.data.week ?? (renderedEntries.length - index);
        const title = entry.data.title ?? `Weekly Progress Log — Week ${weekNum}`;
        const startDate = entry.data.startDate ?? (entry.data.date ? new Date(entry.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Current Week');
        const summary = entry.data.summary ?? '';
        const isLatest = index === 0;

        return (
          <article class="journal-card cyber-frame p-6 sm:p-8 reveal reveal-d1 transition-all" data-week={weekNum}>
            <!-- Top Header / Bar -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
              <div class="flex items-center gap-3">
                <span class="font-mono text-xs font-bold px-3 py-1 bg-[var(--bg-elevated)] border border-[var(--border-frame)] text-[var(--accent-active)] tracking-wider">
                  WEEK {String(weekNum).padStart(2, '0')}
                </span>
                <span class="font-mono text-xs text-[var(--text-muted)]">
                  {startDate}
                </span>
              </div>
              <span class="font-mono text-[0.65rem] uppercase tracking-widest text-[var(--accent-progress)] px-2.5 py-0.5 border border-[var(--accent-progress)]/30 bg-[var(--accent-progress)]/10">
                Log Entry
              </span>
            </div>

            <!-- Title & Summary -->
            <div class="py-4 cursor-pointer journal-toggle group" role="button" tabindex="0" aria-expanded={isLatest ? "true" : "false"}>
              <div class="flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--text-primary)] group-hover:text-[var(--accent-active)] transition-colors cyber-glitch" data-text={title}>
                    {title}
                  </h3>
                  {summary && (
                    <p class="text-sm text-[var(--text-body)] mt-2 leading-relaxed">
                      {summary}
                    </p>
                  )}
                </div>
                <button
                  type="button"
                  class="shrink-0 p-2 border border-[var(--border-frame)] bg-[var(--bg-surface)] text-[var(--text-primary)] group-hover:border-[var(--text-primary)] transition-all toggle-icon mt-1"
                  aria-label="Toggle journal details"
                >
                  <span class="font-mono text-xs font-bold block transition-transform duration-300">
                    {isLatest ? "▲ HIDE" : "▼ READ"}
                  </span>
                </button>
              </div>
            </div>

            <!-- Expandable Body Content -->
            <div class={`journal-body overflow-hidden transition-all duration-500 ${isLatest ? 'block' : 'hidden'}`}>
              <div class="pt-6 border-t border-[var(--border-subtle)] journal-markdown text-sm sm:text-base">
                <Content />
              </div>
            </div>
          </article>
        );
      })
    ) : (
      <div class="cyber-frame p-8 text-center text-[var(--text-muted)] font-mono text-sm">
        No journal logs published yet. Check back soon!
      </div>
    )}
  </div>
</section>

<style is:global>
  /* Markdown styling inside journal cards */
  .journal-markdown h1,
  .journal-markdown h2 {
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--border-subtle);
    font-family: 'Fira Code', monospace;
  }
  .journal-markdown h1:first-child,
  .journal-markdown h2:first-child {
    margin-top: 0;
  }
  .journal-markdown h3,
  .journal-markdown h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-active);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-family: 'Fira Code', monospace;
  }
  .journal-markdown p {
    color: var(--text-body);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .journal-markdown ul {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
    space-y: 0.5rem;
  }
  .journal-markdown ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-body);
    line-height: 1.6;
  }
  .journal-markdown ul li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-active);
    font-weight: bold;
  }
  .journal-markdown strong {
    color: var(--text-primary);
    font-weight: 700;
  }
  .journal-markdown code {
    font-family: 'Fira Code', monospace;
    font-size: 0.85em;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 2px;
    color: var(--accent-progress);
  }
</style>

<script>
  // Accordion toggle behavior
  document.querySelectorAll('.journal-card').forEach((card) => {
    const toggle = card.querySelector('.journal-toggle');
    const body = card.querySelector('.journal-body');
    const toggleBtn = card.querySelector('.toggle-icon span');

    if (toggle && body && toggleBtn) {
      toggle.addEventListener('click', () => {
        const isExpanded = !body.classList.contains('hidden');
        if (isExpanded) {
          body.classList.add('hidden');
          toggleBtn.textContent = '▼ READ';
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          body.classList.remove('hidden');
          toggleBtn.textContent = '▲ HIDE';
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });
</script>
