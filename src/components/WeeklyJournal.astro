---
import { getCollection, render } from 'astro:content';

let entries = [];
try {
  entries = await getCollection('journal');
  entries.sort((a, b) => {
    const weekA = a.data.week ?? 0;
    const weekB = b.data.week ?? 0;
    return weekB - weekA;
  });
} catch (e) {
  console.warn('Could not load journal entries:', e);
}

// Total count of entries for button count
const totalLogs = entries.length;

// Render ONLY the most recent entry for the homepage
const latestEntry = entries[0];
let LatestContent = null;
if (latestEntry) {
  const rendered = await render(latestEntry);
  LatestContent = rendered.Content;
}

const weekNum = latestEntry?.data.week ?? totalLogs;
const title = latestEntry?.data.title ?? `Weekly Progress Log — Week ${weekNum}`;
const startDate = latestEntry?.data.startDate ?? (latestEntry?.data.date ? new Date(latestEntry.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Current Week');
const summary = latestEntry?.data.summary ?? '';
---

<section id="journal" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
        Weekly Progress Logs
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[var(--text-primary)] cyber-glow-text cyber-glitch" data-text="WEEKLY LOG.">
      Weekly Log.
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-body)] mt-2 max-w-2xl">
      Weekly logs keeping track of what i did on a weekly basis:
    </p>
  </div>

  {latestEntry && LatestContent ? (
    <div class="space-y-6">
      <!-- Most Recent Weekly Log Entry Card -->
      <article class="journal-card cyber-frame p-6 sm:p-8 reveal reveal-d1 transition-all" data-week={weekNum}>
        <!-- Top Header / Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
          <div class="flex items-center gap-3">
            <span class="font-mono text-xs font-bold px-3 py-1 bg-[var(--bg-elevated)] border border-[var(--border-frame)] text-[var(--accent-active)] tracking-wider">
              WEEK {String(weekNum).padStart(2, '0')}
            </span>
            <span class="font-mono text-xs text-[var(--text-muted)]">
              {startDate}
            </span>
          </div>
          <span class="font-mono text-[0.65rem] uppercase tracking-widest text-[var(--accent-progress)] px-2.5 py-0.5 border border-[var(--accent-progress)]/30 bg-[var(--accent-progress)]/10 font-bold">
            ● MOST RECENT LOG
          </span>
        </div>

        <!-- Title & Summary Toggle Area -->
        <div class="py-4 cursor-pointer journal-toggle group" role="button" tabindex="0" aria-expanded="true">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--text-primary)] group-hover:text-[var(--accent-active)] transition-colors cyber-glitch" data-text={title}>
                {title}
              </h3>
              {summary && (
                <p class="text-sm text-[var(--text-body)] mt-2 leading-relaxed">
                  {summary}
                </p>
              )}
            </div>
            <button
              type="button"
              class="shrink-0 p-2 border border-[var(--border-frame)] bg-[var(--bg-surface)] text-[var(--text-primary)] group-hover:border-[var(--text-primary)] transition-all toggle-icon mt-1 cursor-pointer"
              aria-label="Toggle journal details"
            >
              <span class="font-mono text-xs font-bold block transition-transform duration-300">
                ▲ HIDE
              </span>
            </button>
          </div>
        </div>

        <!-- Expandable Body Content (Open by default) -->
        <div class="journal-body overflow-hidden transition-all duration-500 block">
          <div class="pt-6 border-t border-[var(--border-subtle)] journal-markdown text-sm sm:text-base">
            <LatestContent />
          </div>
        </div>
      </article>

      <!-- Bottom Navigation CTA for Previous Weeks -->
      <div class="cyber-frame p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 reveal reveal-d2">
        <div>
          <h4 class="font-mono text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider">
            Previous Weekly Logs Archive ({totalLogs} Total)
          </h4>
          <p class="text-xs text-[var(--text-muted)] font-mono mt-1">
            Browse complete week-by-week progress chronicles, technical milestones, and key takeaways.
          </p>
        </div>

        <a 
          href="/journal" 
          class="inline-flex items-center gap-3 px-6 py-3 bg-[var(--text-primary)] text-[var(--bg-canvas)] text-xs font-mono font-bold uppercase tracking-wider hover:scale-[1.02] transition-all shadow-md shrink-0 group"
        >
          <span>View Previous Weeks Archive</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="cyber-frame p-8 text-center text-[var(--text-muted)] font-mono text-sm">
      No journal logs published yet. Check back soon!
    </div>
  )}
</section>

<style is:global>
  /* Markdown styling inside journal cards */
  .journal-markdown h1,
  .journal-markdown h2 {
    font-size: 1.15rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--border-subtle);
    font-family: 'Fira Code', monospace;
  }
  .journal-markdown h1:first-child,
  .journal-markdown h2:first-child {
    margin-top: 0;
  }
  .journal-markdown h3,
  .journal-markdown h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-active);
    margin-top: 1rem;
    margin-bottom: 0.5rem;
    font-family: 'Fira Code', monospace;
  }
  .journal-markdown p {
    color: var(--text-body);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .journal-markdown ul {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
    space-y: 0.5rem;
  }
  .journal-markdown ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-body);
    line-height: 1.6;
  }
  .journal-markdown ul li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-active);
    font-weight: bold;
  }
  .journal-markdown strong {
    color: var(--text-primary);
    font-weight: 700;
  }
  .journal-markdown pre {
    background: #111418 !important;
    border: 1px solid var(--border-frame) !important;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    overflow-x: auto;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .journal-markdown pre code,
  .journal-markdown pre span {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: 'Fira Code', monospace;
  }
  .journal-markdown :not(pre) > code {
    font-family: 'Fira Code', monospace;
    font-size: 0.85em;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    color: var(--accent-progress);
  }
</style>

<script>
  // Accordion toggle behavior
  document.querySelectorAll('.journal-card').forEach((card) => {
    const toggle = card.querySelector('.journal-toggle');
    const body = card.querySelector('.journal-body');
    const toggleBtn = card.querySelector('.toggle-icon span');

    if (toggle && body && toggleBtn) {
      toggle.addEventListener('click', () => {
        const isExpanded = !body.classList.contains('hidden');
        if (isExpanded) {
          body.classList.add('hidden');
          toggleBtn.textContent = '▼ READ';
          toggle.setAttribute('aria-expanded', 'false');
        } else {
          body.classList.remove('hidden');
          toggleBtn.textContent = '▲ HIDE';
          toggle.setAttribute('aria-expanded', 'true');
        }
      });
    }
  });
</script>
