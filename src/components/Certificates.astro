<section id="certificates" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
      — Simple Certificates & Credentials
    </span>
  </div>

  <!-- Vault Tiles Grid (Clickable for Lightbox) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 mb-16 reveal reveal-d1">
    
    <!-- ISC2 CC -->
    <div class="vault-tile cyber-frame p-6 cursor-pointer" data-lightbox="isc2">
      <div class="font-mono text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-2">ISC2</div>
      <h4 class="text-base font-extrabold text-[var(--text-primary)] mb-2">Certified in Cybersecurity (CC)</h4>
      <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">Validates foundational knowledge in security principles, incident response, access controls, and network security.</p>
      <span class="text-[0.65rem] font-mono text-[var(--text-muted)] block">Click for Details ➔</span>
    </div>

    <!-- Cisco Network Security -->
    <div class="vault-tile cyber-frame p-6 cursor-pointer" data-lightbox="networking">
      <div class="font-mono text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-2">Cisco</div>
      <h4 class="text-base font-extrabold text-[var(--text-primary)] mb-2">Network Support & Security</h4>
      <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">Cisco-verified credential for supporting and securing endpoints, networks, and remote users.</p>
      <span class="text-[0.65rem] font-mono text-[var(--text-muted)] block">Click for Details ➔</span>
    </div>

    <!-- Securiti -->
    <div class="vault-tile cyber-frame p-6 cursor-pointer" data-lightbox="securiti">
      <div class="font-mono text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-2">Securiti</div>
      <h4 class="text-base font-extrabold text-[var(--text-primary)] mb-2">AI Governance & Security</h4>
      <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">Demonstrates understanding of responsible AI deployment, data governance, and privacy principles.</p>
      <span class="text-[0.65rem] font-mono text-[var(--text-muted)] block">Click for Details ➔</span>
    </div>

    <!-- OPSWAT ICIP -->
    <div class="vault-tile cyber-frame p-6 cursor-pointer" data-lightbox="icip">
      <div class="font-mono text-[0.65rem] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-2">OPSWAT Academy</div>
      <h4 class="text-base font-extrabold text-[var(--text-primary)] mb-2">Critical Infrastructure (ICIP)</h4>
      <p class="text-xs text-[var(--text-body)] leading-relaxed mb-4">Defensive requirements for Industrial Control Systems (ICS) and Essential Services.</p>
      <span class="text-[0.65rem] font-mono text-[var(--text-muted)] block">Click for Details ➔</span>
    </div>

