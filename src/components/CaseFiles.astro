---
import { getCollection } from 'astro:content';

let investigations = [];
try {
  const allDocs = await getCollection('investigations');
  investigations = allDocs.filter(doc => doc.data?.published !== false && !doc.id.includes('_template'));
  investigations.sort((a, b) => {
    const dateA = a.data?.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data?.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });
} catch (e) {
  console.warn('Could not load investigations for teaser:', e);
}
---

<section id="case-files" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
        Lab Documentation &amp; Incident Reports
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[var(--text-primary)] cyber-glow-text cyber-glitch" data-text="LAB DOCUMENTATION.">
      Lab Documentation.
    </h2>
    <p class="text-sm sm:text-base text-[var(--text-body)] mt-2 max-w-2xl">
      Hands-on DFIR investigation case reports from HTB Sherlocks and enterprise security labs. Full forensic triage, log parsing, and detection engineering:
    </p>
  </div>

  <!-- Standard Documentation Pipeline Grid & Direct Link Card -->
  <div class="cyber-frame p-6 sm:p-10 reveal reveal-d1 space-y-8">
    
    <div>
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4 border border-[var(--border-frame)] px-3 py-1 bg-[var(--bg-elevated)]">
        <span class="w-2 h-2 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
        Investigation Standards &amp; Methodology
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4 border-t border-[var(--border-subtle)]">
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">01 // Scenario &amp; Scope</span>
          <p class="text-xs text-[var(--text-muted)]">Alert premise, triage context, and scope definition.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">02 // Tools &amp; Environment</span>
          <p class="text-xs text-[var(--text-muted)]">Wireshark, Volatility, Zimmerman Tools, VirusTotal, WHOIS.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">03 // Step-by-Step Triage</span>
          <p class="text-xs text-[var(--text-muted)]">Task analysis, header parsing, payload extraction, and queries.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">04 // Evidence &amp; Defense</span>
          <p class="text-xs text-[var(--text-muted)]">Extracted IOC tables, MITRE mapping, and SEG/EDR rules.</p>
        </div>
      </div>
    </div>

    <!-- Case Files Directory Preview & Direct Navigation CTA -->
    <div class="pt-6 border-t border-[var(--border-subtle)] space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="font-mono text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
          Published Investigation Case Files ({investigations.length})
        </span>
        <span class="font-mono text-[0.7rem] text-[var(--accent-progress)] font-bold">
          [ LIVE DOCUMENTATION ARCHIVE ]
        </span>
      </div>

      <!-- Quick preview list of cases -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {investigations.map((doc) => {
          const title = doc.data?.title ?? doc.id;
          const category = doc.data?.category ?? 'Security Lab';
          const difficulty = doc.data?.difficulty ?? 'Practical';

          return (
            <a 
              href="/labs" 
              class="p-4 border border-[var(--border-frame)] bg-[var(--bg-surface)] hover:border-[var(--accent-active)] hover:bg-[var(--bg-elevated)] transition-all group block"
            >
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="font-mono text-[0.65rem] font-bold px-2 py-0.5 bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--accent-active)] uppercase tracking-wider">
                  {category}
                </span>
                <span class="font-mono text-[0.65rem] text-[var(--text-muted)] uppercase">
                  {difficulty}
                </span>
              </div>
              <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-active)] transition-colors line-clamp-1">
                {title}
              </h3>
            </a>
          );
        })}
      </div>

      <!-- Primary Action Button -->
      <div class="pt-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <a 
          href="/labs" 
          class="inline-flex items-center gap-3 px-6 py-3 bg-[var(--text-primary)] text-[var(--bg-canvas)] text-xs font-mono font-bold uppercase tracking-wider hover:scale-[1.02] transition-all shadow-md group"
        >
          <span>Click to View Full Documentation &amp; Reports</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>
        <p class="text-xs font-mono text-[var(--text-muted)]">
          Interactive full-length writeups, commands, IOC matrices &amp; MITRE mappings.
        </p>
      </div>

    </div>

  </div>
</section>
