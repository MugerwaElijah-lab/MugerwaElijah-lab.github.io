<section id="home" class="min-h-screen flex items-center max-w-[1200px] mx-auto px-6 sm:px-12 pt-36 pb-20">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center w-full">
    
    <!-- Hero Text Content -->
    <div class="lg:col-span-7 hero-content">
      <div class="inline-block px-3 py-1 mb-4 text-[0.65rem] font-mono font-bold uppercase tracking-[3px] border border-[var(--border-frame)] bg-[var(--bg-elevated)] text-[var(--text-muted)] shadow-sm">
        $ whoami: Cybersecurity Engineer // Detection Engineer
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tighter leading-[0.9] text-[var(--text-primary)] mb-4 uppercase reveal cyber-glow-text cyber-glitch" data-text="MUGERWA ELIJAH.">
        Mugerwa<br />Elijah.
      </h1>

      <!-- Typing animation box -->
      <div class="font-mono text-sm sm:text-lg font-medium text-[var(--text-muted)] h-10 flex items-center mb-6 reveal reveal-d1">
        <span id="typing" class="text-[var(--text-primary)]"></span><span class="inline-block w-[2px] h-[1.2em] bg-[var(--text-primary)] ml-1 animate-pulse"></span>
      </div>

      <div class="cyber-frame p-6 sm:p-8 mb-8 reveal reveal-d2">
        <p class="text-sm sm:text-base leading-relaxed text-[var(--text-body)]">
          I am a cybersecurity professional specializing in blue team security including: <strong class="text-[var(--text-primary)] font-bold">Threat Intelligence, Threat Detection, Incident Response (DFIR), and SOC/NOC operations</strong>. My goal is to evolve into a <strong class="text-[var(--text-primary)] font-bold">Cybersecurity Architect</strong> designing resilient systems that protect digital assets. This portfolio showcases my active operational practice, lab write-ups, and continuous growth. Feel free to reach out let's talk security
        </p>
      </div>

      <!-- Action Buttons & Email -->
      <div class="flex flex-wrap items-center gap-3 reveal reveal-d3">
        <a href="https://www.linkedin.com/in/mugerwa-elijah-williams-b12112306" target="_blank" rel="noopener" class="px-6 py-3 bg-[var(--text-primary)] text-[var(--bg-canvas)] rounded-md text-[0.75rem] font-extrabold uppercase tracking-wider hover:scale-[1.02] transition-transform shadow-md">
          LinkedIn
        </a>
        <a href="mailto:mugerwawilliams62@gmail.com" class="font-mono text-xs text-[var(--text-body)] bg-[var(--bg-surface)] px-4 py-3 border border-[var(--border-subtle)] rounded-md tracking-tight hover:text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all">
          mugerwawilliams62@gmail.com
        </a>
      </div>
    </div>

    <!-- 3D Tilt Portrait Image Area -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end reveal reveal-d2">
      <div class="relative group" id="tilt-wrapper" style="perspective: 1200px;">
        <div id="profile-card" class="relative rounded-2xl overflow-hidden border border-[var(--border-frame)] transition-transform duration-700 ease-out">
          <img src="/potrait.jpg" alt="Mugerwa Elijah - Security Operations Analyst" class="w-[280px] sm:w-[340px] h-[360px] sm:h-[440px] object-cover filter grayscale contrast-105 transition-all duration-700" id="profile-img" />
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-canvas)] via-transparent to-transparent opacity-40"></div>
        </div>
        <div id="profile-shadow" class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-4/5 h-10 bg-black/30 rounded-full blur-xl pointer-events-none transition-all duration-700"></div>
      </div>
    </div>

  </div>
</section>

<script>
  // Typing animation
  const textEl = document.getElementById('typing');
  const phrases = [
    'Cybersecurity Engineer // Detection Engineer',
    'Threat Detection & Incident Response',
    'Enterprise Infrastructure Security'
  ];
  let pIdx = 0, cIdx = 0, isDel = false;

  function typeLoop() {
    if (!textEl) return;
    const full = phrases[pIdx];
    textEl.textContent = isDel ? full.substring(0, cIdx--) : full.substring(0, cIdx++);
    let speed = isDel ? 30 : 80;
    if (!isDel && cIdx === full.length + 1) { isDel = true; speed = 2600; }
    else if (isDel && cIdx === 0) { isDel = false; pIdx = (pIdx + 1) % phrases.length; speed = 400; }
    setTimeout(typeLoop, speed);
  }
  typeLoop();

  // 3D Tilt effect
  const tiltWrapper = document.getElementById('tilt-wrapper');
  const profileCard = document.getElementById('profile-card');
  const profileImg = document.getElementById('profile-img');
  const profileShadow = document.getElementById('profile-shadow');

  if (tiltWrapper && profileCard) {
    tiltWrapper.addEventListener('mousemove', (e) => {
      const rect = tiltWrapper.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      const mx = e.clientX - cx;
      const my = e.clientY - cy;

      const rotateY = (mx / (rect.width / 2)) * 12;
      const rotateX = -(my / (rect.height / 2)) * 8;

      profileCard.style.transform = `rotateY(${rotateY}deg) rotateX(${rotateX}deg) scale(1.02)`;
      if (profileImg) profileImg.style.filter = 'grayscale(0%) contrast(1.02)';

      if (profileShadow) {
        const shadowX = -rotateY * 1.5;
        profileShadow.style.transform = `translateX(calc(-50% + ${shadowX}px))`;
        profileShadow.style.opacity = '0.3';
      }
    });

    tiltWrapper.addEventListener('mouseleave', () => {
      profileCard.style.transform = 'rotateY(0deg) rotateX(0deg) scale(1)';
      if (profileImg) profileImg.style.filter = 'grayscale(100%) contrast(1.05)';
      if (profileShadow) {
        profileShadow.style.transform = 'translateX(-50%)';
        profileShadow.style.opacity = '0.15';
      }
    });
  }
</script>
