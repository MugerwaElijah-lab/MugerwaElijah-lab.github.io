---
---

<!-- Fixed Header Container -->
<header class="fixed top-4 left-0 right-0 z-[9000] px-4 sm:px-6 flex justify-center pointer-events-none">
  <!-- Main Glass Nav Pill -->
  <nav id="main-nav" class="pointer-events-auto w-full max-w-fit px-4 sm:px-6 py-2.5 sm:py-3 rounded-full flex items-center justify-between gap-3 sm:gap-6 border border-[var(--glass-border)] bg-[var(--glass-nav)] backdrop-blur-md transition-all duration-300 shadow-lg">
    
    <!-- Brand Name -->
    <a href="/#home" class="font-black text-xs sm:text-xs uppercase tracking-[2px] sm:tracking-[2.5px] whitespace-nowrap text-[var(--text-primary)] hover:opacity-80 transition-opacity">
      <span>Mugerwa Elijah</span><span class="hidden sm:inline"> Williams</span>
    </a>

    <!-- Desktop Navigation Links (Visible on large screens) -->
    <div class="hidden lg:flex items-center gap-3.5 xl:gap-5">
      <a href="/#home" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">About</a>
      <a href="/#journey" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Journey</a>
      <a href="/#radar" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Goals</a>
      <a href="/#journal" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Weekly Log</a>
      <a href="/#case-files" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Lab Docs</a>
      <a href="/#projects" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Projects</a>
      <a href="/#arsenal" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Arsenal</a>
      <a href="/#certificates" class="text-[0.68rem] xl:text-[0.72rem] font-bold uppercase tracking-[1.2px] xl:tracking-[1.5px] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors whitespace-nowrap">Certificates</a>
    </div>

    <!-- Actions (Theme Toggle & Mobile Menu Toggle) -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Theme Toggle -->
      <button id="theme-toggle" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center border border-[var(--border-frame)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:scale-110 transition-transform cursor-pointer" aria-label="Toggle Dark/Light Theme">
        <span id="theme-icon" class="text-xs">☾</span>
      </button>

      <!-- Mobile Hamburger Button (Visible below large screens) -->
      <button id="mobile-menu-toggle" class="lg:hidden w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center border border-[var(--border-frame)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--text-primary)] transition-all cursor-pointer" aria-label="Open Navigation Menu" aria-expanded="false">
        <span id="mobile-menu-icon" class="font-mono text-xs">☰</span>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="pointer-events-auto absolute top-16 left-4 right-4 sm:left-auto sm:right-auto sm:w-[380px] p-5 rounded-2xl border border-[var(--glass-border)] bg-[var(--bg-surface)]/95 backdrop-blur-xl shadow-2xl transition-all duration-300 opacity-0 scale-95 pointer-events-none -translate-y-2">
    <div class="flex items-center justify-between pb-3 mb-3 border-b border-[var(--border-subtle)]">
      <span class="text-[0.65rem] font-mono font-bold uppercase tracking-[2px] text-[var(--text-muted)]">
        Navigation Menu
      </span>
      <span class="text-[0.65rem] font-mono text-[var(--accent-active)] font-bold">
        ● PORTFOLIO
      </span>
    </div>

    <div class="grid grid-cols-2 gap-2">
      <a href="/#home" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> About
      </a>
      <a href="/#journey" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Journey
      </a>
      <a href="/#radar" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Goals
      </a>
      <a href="/#journal" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Weekly Log
      </a>
      <a href="/#case-files" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Lab Docs
      </a>
      <a href="/#projects" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Projects
      </a>
      <a href="/#arsenal" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Arsenal
      </a>
      <a href="/#certificates" class="mobile-nav-link p-2.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-active)] hover:text-[var(--accent-active)] text-xs font-mono font-bold uppercase tracking-wider transition-colors flex items-center gap-2">
        <span>▹</span> Certificates
      </a>
    </div>

    <div class="mt-3 pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between">
      <a href="/cv" class="text-xs font-mono text-[var(--accent-active)] hover:underline font-bold">
        📄 View Online CV ➔
      </a>
      <span class="text-[0.65rem] font-mono text-[var(--text-muted)]">
        Mugerwa Elijah Williams
      </span>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const themeToggle = document.getElementById('theme-toggle');
  const themeIcon = document.getElementById('theme-icon');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileIcon = document.getElementById('mobile-menu-icon');
  const mobileMenu = document.getElementById('mobile-menu');

  // Update theme icon on load
  function updateThemeUI() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    if (themeIcon) {
      themeIcon.textContent = currentTheme === 'dark' ? '☾' : '☼';
    }
  }
  updateThemeUI();

  // Toggle theme
  themeToggle?.addEventListener('click', () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', newTheme);
    localStorage.setItem('theme', newTheme);
    updateThemeUI();
  });

  // Mobile menu toggle
  let isMenuOpen = false;

  function openMobileMenu() {
    if (!mobileMenu || !mobileToggle || !mobileIcon) return;
    isMenuOpen = true;
    mobileMenu.classList.remove('opacity-0', 'scale-95', 'pointer-events-none', '-translate-y-2');
    mobileMenu.classList.add('opacity-100', 'scale-100', 'translate-y-0');
    mobileToggle.setAttribute('aria-expanded', 'true');
    mobileIcon.textContent = '✕';
  }

  function closeMobileMenu() {
    if (!mobileMenu || !mobileToggle || !mobileIcon) return;
    isMenuOpen = false;
    mobileMenu.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
    mobileMenu.classList.add('opacity-0', 'scale-95', 'pointer-events-none', '-translate-y-2');
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileIcon.textContent = '☰';
  }

  mobileToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (isMenuOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  });

  // Close menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      closeMobileMenu();
    });
  });

  // Close menu on click outside
  document.addEventListener('click', (e) => {
    if (isMenuOpen && mobileMenu && !mobileMenu.contains(e.target as Node) && e.target !== mobileToggle) {
      closeMobileMenu();
    }
  });

  // Close menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      closeMobileMenu();
    }
  });

  // Nav scroll blur enhancement
  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav?.classList.add('shadow-2xl', 'border-[var(--text-muted)]');
    } else {
      nav?.classList.remove('shadow-2xl', 'border-[var(--text-muted)]');
    }
  }, { passive: true });
</script>
