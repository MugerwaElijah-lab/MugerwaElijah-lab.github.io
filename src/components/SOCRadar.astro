---
---

<section id="radar" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
      — Active SOC Operations & Lab Status
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    
    <!-- CDSA Card -->
    <div class="cyber-frame p-6 sm:p-8 reveal reveal-d1">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-xs font-bold text-[var(--accent-progress)] border border-[var(--accent-progress)]/30 px-3 py-1 bg-[var(--accent-progress)]/10 uppercase tracking-widest">
          ● IN PROGRESS
        </span>
        <span class="font-mono text-[0.65rem] text-[var(--text-muted)] tracking-wider">HTB ACADEMY</span>
      </div>

      <h3 class="text-xl font-extrabold text-[var(--text-primary)] mb-2 uppercase tracking-tight">
        Certified Defensive Security Analyst (CDSA)
      </h3>
      <p class="font-mono text-xs text-[var(--text-muted)] mb-4">Path: SOC Analyst Track</p>

      <div class="pt-4 border-t border-[var(--border-subtle)]">
        <span class="font-mono text-xs text-[var(--text-muted)] block mb-1">Focus Areas:</span>
        <p class="text-xs sm:text-sm text-[var(--text-body)] font-medium">
          SIEM Architecture · Security Operations Center Workflows · Digital Forensics & Incident Response (DFIR)
        </p>
      </div>
    </div>

    <!-- BTL1 Card -->
    <div class="cyber-frame p-6 sm:p-8 reveal reveal-d2">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-xs font-bold text-[var(--accent-active)] border border-[var(--accent-active)]/30 px-3 py-1 bg-[var(--accent-active)]/10 uppercase tracking-widest">
          ◐ ACTIVE PREP
        </span>
        <span class="font-mono text-[0.65rem] text-[var(--text-muted)] tracking-wider">SECURITY BLUE TEAM</span>
      </div>

      <h3 class="text-xl font-extrabold text-[var(--text-primary)] mb-2 uppercase tracking-tight">
        Blue Team Level 1 (BTL1)
      </h3>
      <p class="font-mono text-xs text-[var(--text-muted)] mb-4">Focus: Incident Response & Defense</p>

      <div class="pt-4 border-t border-[var(--border-subtle)]">
        <span class="font-mono text-xs text-[var(--text-muted)] block mb-1">Focus Areas:</span>
        <p class="text-xs sm:text-sm text-[var(--text-body)] font-medium">
          Live Network Analysis · Memory Forensics · Phishing Triage & Analysis · Threat Intelligence
        </p>
      </div>
    </div>

  </div>
</section>
