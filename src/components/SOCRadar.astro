---
---

<section id="radar" class="py-24 max-w-[1200px] mx-auto px-6 sm:px-12">
  <div class="mb-12 reveal">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-2 h-2 rounded-full bg-[var(--accent-progress)] animate-pulse"></span>
      <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
        Goals
      </span>
    </div>
    <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-[var(--text-primary)] cyber-glow-text cyber-glitch" data-text="GOALS.">
      Goals.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    
    <!-- CDSA Card -->
    <div class="cyber-frame p-6 sm:p-8 reveal reveal-d1">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-xs font-bold text-[var(--accent-progress)] border border-[var(--accent-progress)]/30 px-3 py-1 bg-[var(--accent-progress)]/10 uppercase tracking-widest">
          ● IN PROGRESS
        </span>
        <span class="font-mono text-[0.65rem] text-[var(--text-muted)] tracking-wider">HTB ACADEMY</span>
      </div>

      <h3 class="text-xl font-extrabold text-[var(--text-primary)] mb-2 uppercase tracking-tight cyber-glitch" data-text="Certified Defensive Security Analyst (CDSA)">
        Certified Defensive Security Analyst (CDSA)
      </h3>
      <p class="font-mono text-xs text-[var(--text-muted)] mb-4">Path: SOC Analyst Track</p>

      <div class="pt-4 border-t border-[var(--border-subtle)]">
        <span class="font-mono text-xs text-[var(--text-muted)] block mb-1">Focus Areas:</span>
        <p class="text-xs sm:text-sm text-[var(--text-body)] font-medium">
          SIEM Architecture · Incident Handling Process · Threat Hunting · Digital Forensics &amp; Incident Response (DFIR)
        </p>
      </div>
    </div>

    <!-- PNPT Card -->
    <div class="cyber-frame p-6 sm:p-8 reveal reveal-d2">
      <div class="flex items-center justify-between mb-4">
        <span class="font-mono text-xs font-bold text-[var(--accent-progress)] border border-[var(--accent-progress)]/30 px-3 py-1 bg-[var(--accent-progress)]/10 uppercase tracking-widest">
          ● IN PROGRESS
        </span>
        <span class="font-mono text-[0.65rem] text-[var(--text-muted)] tracking-wider">TCM SECURITY</span>
      </div>

      <h3 class="text-xl font-extrabold text-[var(--text-primary)] mb-2 uppercase tracking-tight cyber-glitch" data-text="Practical Network Penetration Tester (PNPT)">
        Practical Network Penetration Tester (PNPT)
      </h3>
      <p class="font-mono text-xs text-[var(--text-muted)] mb-4">Path: Offensive Security &amp; Network Penetration Testing</p>

      <div class="pt-4 border-t border-[var(--border-subtle)]">
        <span class="font-mono text-xs text-[var(--text-muted)] block mb-1">Focus Areas:</span>
        <p class="text-xs sm:text-sm text-[var(--text-body)] font-medium">
          Open-Source Intelligence (OSINT) · External &amp; Internal Network Pentesting · Active Directory Exploitation · Lateral Movement · Professional Report Writing
        </p>
      </div>
    </div>

  </div>
</section>
