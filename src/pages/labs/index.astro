---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

let investigations = [];
try {
  const allDocs = await getCollection('investigations');
  investigations = allDocs.filter(doc => doc.data?.published !== false && !doc.id.includes('_template'));
  investigations.sort((a, b) => {
    const dateA = a.data?.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data?.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });
} catch (e) {
  console.warn('Could not load investigation reports:', e);
}

// Render markdown content for each published report
const renderedDocs = await Promise.all(
  investigations.map(async (doc) => {
    const { Content } = await render(doc);
    return {
      doc,
      Content,
    };
  })
);
---

<BaseLayout 
  title="Lab Documentation & Case Files | Mugerwa Elijah"
  description="Hands-on DFIR investigation case reports from HTB Sherlocks and enterprise security labs. Full forensic triage, log parsing, and detection engineering."
>
  <div class="py-28 max-w-[1100px] mx-auto px-6 sm:px-12 space-y-12">
    
    <!-- Top Navigation / Breadcrumbs -->
    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href="/#case-files" class="inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] hover:text-[var(--accent-active)] transition-colors">
        <span>←</span> Back to Portfolio
      </a>

      <span class="font-mono text-xs text-[var(--text-muted)] border border-[var(--border-subtle)] px-3 py-1 bg-[var(--bg-elevated)]">
        <strong class="text-[var(--accent-active)]">{renderedDocs.length}</strong> Case Reports Published
      </span>
    </div>

    <!-- Main Header -->
    <div class="cyber-frame p-6 sm:p-10 space-y-4">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
        <span class="text-xs font-mono font-bold uppercase tracking-[4px] text-[var(--text-muted)]">
          DFIR &amp; Threat Intelligence Knowledge Base
        </span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-[var(--text-primary)] cyber-glow-text cyber-glitch" data-text="LAB DOCUMENTATION.">
        Lab Documentation.
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-body)] max-w-3xl leading-relaxed">
        Comprehensive repository of hands-on Digital Forensics, Incident Response (DFIR), and Threat Intelligence investigation reports from Hack The Box Sherlocks and enterprise security homelabs. Each report details full forensic triage steps, query structures, Indicators of Compromise (IOCs), and defensive engineering mitigations.
      </p>
    </div>

    <!-- Standard Documentation Pipeline Grid -->
    <div class="cyber-frame p-6 sm:p-8">
      <div class="inline-flex items-center gap-2 font-mono text-xs font-bold text-[var(--text-muted)] uppercase tracking-widest mb-4 border border-[var(--border-frame)] px-3 py-1 bg-[var(--bg-elevated)]">
        <span class="w-2 h-2 rounded-full bg-[var(--accent-active)] animate-pulse"></span>
        Investigation Standards &amp; Methodology
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4 border-t border-[var(--border-subtle)]">
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">01 // Scenario &amp; Scope</span>
          <p class="text-xs text-[var(--text-muted)]">Alert premise, triage context, and scope definition.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">02 // Tools &amp; Environment</span>
          <p class="text-xs text-[var(--text-muted)]">Wireshark, Volatility, Zimmerman Tools, VirusTotal, WHOIS.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">03 // Step-by-Step Triage</span>
          <p class="text-xs text-[var(--text-muted)]">Task analysis, header parsing, payload extraction, and queries.</p>
        </div>
        <div class="space-y-1">
          <span class="font-mono text-xs font-bold text-[var(--text-primary)] block">04 // Evidence &amp; Defense</span>
          <p class="text-xs text-[var(--text-muted)]">Extracted IOC tables, MITRE mapping, and SEG/EDR rules.</p>
        </div>
      </div>
    </div>

    <!-- Published Lab Documentation Reports List -->
    <div class="space-y-8">
      {renderedDocs.length > 0 ? (
        renderedDocs.map(({ doc, Content }, index) => {
          const title = doc.data?.title ?? doc.id;
          const category = doc.data?.category ?? 'Security Lab';
          const difficulty = doc.data?.difficulty ?? 'Practical';
          const summary = doc.data?.summary ?? '';
          const tools = doc.data?.tools ?? [];
          const dateStr = doc.data?.date ? new Date(doc.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
          const isFirst = index === 0;

          return (
            <article class="lab-card cyber-frame p-6 sm:p-8 transition-all" data-lab-id={doc.id}>
              <!-- Top Badges / Meta -->
              <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-[var(--border-subtle)]">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="font-mono text-[0.65rem] font-bold px-3 py-1 bg-[var(--bg-elevated)] border border-[var(--border-frame)] text-[var(--accent-active)] tracking-wider uppercase">
                    {category}
                  </span>
                  <span class="font-mono text-[0.65rem] font-bold px-2.5 py-1 bg-[var(--accent-progress)]/10 border border-[var(--accent-progress)]/30 text-[var(--accent-progress)] tracking-wider uppercase">
                    {difficulty}
                  </span>
                </div>
                {dateStr && (
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {dateStr}
                  </span>
                )}
              </div>

              <!-- Title & Summary Toggle Area -->
              <div class="py-5 cursor-pointer lab-toggle group" role="button" tabindex="0" aria-expanded={isFirst ? "true" : "false"}>
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h2 class="text-xl sm:text-2xl font-extrabold text-[var(--text-primary)] group-hover:text-[var(--accent-active)] transition-colors cyber-glitch" data-text={title}>
                      {title}
                    </h2>
                    {summary && (
                      <p class="text-sm text-[var(--text-body)] mt-2 leading-relaxed">
                        {summary}
                      </p>
                    )}
                    {tools.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mt-4">
                        {tools.map((t: string) => (
                          <span class="font-mono text-[0.65rem] px-2 py-0.5 bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--text-muted)]">
                            {t}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>

                  <button
                    type="button"
                    class="shrink-0 p-2.5 border border-[var(--border-frame)] bg-[var(--bg-surface)] text-[var(--text-primary)] group-hover:border-[var(--text-primary)] transition-all lab-toggle-btn mt-1 cursor-pointer"
                    aria-label="Toggle full lab writeup"
                  >
                    <span class="font-mono text-xs font-bold block">
                      {isFirst ? "▲ HIDE REPORT" : "▼ READ REPORT"}
                    </span>
                  </button>
                </div>
              </div>

              <!-- Expandable Report Body Content -->
              <div class={`lab-body overflow-hidden transition-all duration-500 ${isFirst ? 'block' : 'hidden'}`}>
                <div class="pt-6 border-t border-[var(--border-subtle)] lab-markdown text-sm sm:text-base">
                  <Content />
                </div>
              </div>
            </article>
          );
        })
      ) : (
        <div class="cyber-frame p-8 text-center text-[var(--text-muted)] font-mono text-sm">
          No completed lab reports published yet.
        </div>
      )}
    </div>

    <!-- Bottom Return Action -->
    <div class="pt-8 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-4">
      <a href="/#case-files" class="inline-block px-5 py-2.5 bg-[var(--text-primary)] text-[var(--bg-canvas)] text-xs font-mono font-bold uppercase tracking-wider hover:scale-[1.02] transition-transform shadow-md">
        ← Return to Portfolio
      </a>
      <span class="text-xs font-mono text-[var(--text-muted)]">
        Mugerwa Elijah Williams · DFIR &amp; Security Operations
      </span>
    </div>

  </div>
</BaseLayout>

<style is:global>
  /* Lab Documentation Markdown Styling */
  .lab-markdown h1,
  .lab-markdown h2 {
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px dashed var(--border-subtle);
    font-family: 'Fira Code', monospace;
  }
  .lab-markdown h1:first-child,
  .lab-markdown h2:first-child {
    margin-top: 0;
  }
  .lab-markdown h3,
  .lab-markdown h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-active);
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    font-family: 'Fira Code', monospace;
  }
  .lab-markdown p {
    color: var(--text-body);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .lab-markdown ul {
    list-style-type: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
  }
  .lab-markdown ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-body);
    line-height: 1.6;
  }
  .lab-markdown ul li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-active);
    font-weight: bold;
  }
  .lab-markdown ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .lab-markdown ol li {
    margin-bottom: 0.5rem;
    color: var(--text-body);
    line-height: 1.6;
  }
  .lab-markdown strong {
    color: var(--text-primary);
    font-weight: 700;
  }
  .lab-markdown blockquote {
    border-left: 3px solid var(--accent-active);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--text-body);
    background: var(--bg-elevated);
    padding: 0.75rem 1rem;
    border-radius: 0 4px 4px 0;
  }
  .lab-markdown table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.85rem;
    font-family: 'Fira Code', monospace;
  }
  .lab-markdown th {
    background: var(--bg-elevated);
    color: var(--text-primary);
    font-weight: 700;
    text-align: left;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border-frame);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.5px;
  }
  .lab-markdown td {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--border-subtle);
    color: var(--text-body);
  }
  .lab-markdown tr:nth-child(even) td {
    background: var(--glass-fill);
  }
  .lab-markdown img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border-frame);
    border-radius: 4px;
    margin: 1.25rem 0;
    background: var(--bg-elevated);
  }
  .lab-markdown pre {
    background: #111418 !important;
    border: 1px solid var(--border-frame) !important;
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin: 1.25rem 0;
    overflow-x: auto;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .lab-markdown pre code,
  .lab-markdown pre span {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    font-family: 'Fira Code', monospace;
  }
  .lab-markdown :not(pre) > code {
    font-family: 'Fira Code', monospace;
    font-size: 0.85em;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    color: var(--accent-progress);
  }
  .lab-markdown hr {
    border: none;
    border-top: 1px dashed var(--border-subtle);
    margin: 2rem 0;
  }
</style>

<script>
  // Lab report accordion toggle behavior
  document.querySelectorAll('.lab-card').forEach((card) => {
    const toggle = card.querySelector('.lab-toggle');
    const body = card.querySelector('.lab-body');
    const toggleBtn = card.querySelector('.lab-toggle-btn span');

    if (toggle && body && toggleBtn) {
      toggle.addEventListener('click', () => {
        const isHidden = body.classList.contains('hidden');
        if (isHidden) {
          body.classList.remove('hidden');
          body.classList.add('block');
          toggleBtn.textContent = '▲ HIDE REPORT';
          toggle.setAttribute('aria-expanded', 'true');
        } else {
          body.classList.remove('block');
          body.classList.add('hidden');
          toggleBtn.textContent = '▼ READ REPORT';
          toggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
</script>
